Resolve CameraView and zxing-cpp from a local maven repo instead of jitpack.io.

diff --git a/build.gradle b/build.gradle
index 9be7983..aa513b2 100644
--- a/build.gradle
+++ b/build.gradle
@@ -16,9 +16,17 @@ buildscript {

 allprojects {
